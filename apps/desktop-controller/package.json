{
  "name": "@remote/desktop-controller",
  "version": "0.5.0",
  "private": true,
  "type": "module",
  "main": "src/main.js",
  "scripts": {
    "dev": "electron .",
    "check": "node --check src/main.js && node --check src/preload.cjs && node --check src/renderer.js",
    "dist:win": "electron-builder --win portable --x64"
  },
  "devDependencies": {
    "electron": "44.1.1",
    "electron-builder": "^26.0.12"
  },
  "build": {
    "appId": "org.remote.support.controller",
    "productName": "IT Remote Support Console",
    "asar": true,
    "files": [
      "src/**/*",
      "package.json"
    ],
    "directories": {
      "output": "release"
    },
    "win": {
      "target": "portable",
      "icon": "src/app-icon.png",
      "artifactName": "Remote-Support-Controller-${version}-Windows-${arch}.${ext}"
    }
  },
  "dependencies": {
    "gsap": "^3.13.0"
  }
}

