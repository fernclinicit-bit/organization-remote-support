SIGNALING_PORT=8080
# Generate a random value of at least 32 bytes. Never commit the real value.
SESSION_SIGNING_SECRET=replace-with-a-long-random-secret
TURN_REALM=remote.example.org
TURN_USERNAME=remote-service
TURN_PASSWORD=replace-with-a-long-random-password

# Managed public TURN (server-side only; never embed these values in an app).
CLOUDFLARE_TURN_KEY_ID=replace-with-cloudflare-turn-key-id
CLOUDFLARE_TURN_API_TOKEN=replace-with-cloudflare-turn-api-token
TURN_CREDENTIAL_TTL=86400
